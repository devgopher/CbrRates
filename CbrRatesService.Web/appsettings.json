{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cbr": {
    "BaseUrl": "https://www.cbr.ru",
    "Timeout": 30,
    "Retry": {
      "Delay": "00:00:02",
      "Retries": 3
    }
  },
  "CacheSettings": {
    "Redis": {
      "Enabled": false,
      "DefaultExpiration": "00:05:00",
      "EngineSettings": {
        "ConnectionString": "localhost:6379"
      }
    },
    "Memory": {
      "Enabled": true,
      "DefaultExpiration": "00:05:00",
      "EngineSettings": {
        "ExpirationScanFrequency": "00:01:00"
      }
    }
  }
}
